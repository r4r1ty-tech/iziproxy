# Android signing keystore (не коммитить!)
*.keystore

# Dotnet build folders
[Bb]in/
[Oo]bj/

# IDE configurations
.idea/
.vscode/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Publish output — генерируется при сборке, не коммитим
publish_linux/
publish_win_x86/
publish_win_arm64/

# AppImage toolchain — скачивается один раз при сборке
appimagetool
squashfs-root/
# Артефакт --appimage-extract: симлинк на иконку, появляется при сборке
AppDir/.DirIcon

# AppDir/bin — это артефакт публикации (заполняется на лету при сборке)
AppDir/usr/

# xray.zip — большой бинарь, не нужен в репе (используется только при локальной разработке)
xray.zip

# Локальные логи приложения
IziProxy_Log.txt
*.log

# OS metadata
.DS_Store
Thumbs.db

# docs/ — локальные заметки и черновики, в репе не нужны
docs/

# Временные файлы и backup
*.tmp
*.bak
*~
