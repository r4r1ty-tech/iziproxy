<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:IziProxy.GUI"
             xmlns:vm="using:IziProxy.GUI.ViewModels"
             xmlns:core="using:IziProxy"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="IziProxy.GUI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="12,12,12,24">

      <!-- Заголовок -->
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,8">
        <Border Background="{StaticResource PrimaryContainerBrush}"
                Width="48" Height="48"
                CornerRadius="16">
          <materialIcons:MaterialIcon Kind="ChartBox" Width="24" Height="24" Foreground="{StaticResource PrimaryBrush}"/>
        </Border>
        <TextBlock Text="{l:Tr Dash_Title}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
      </StackPanel>

      <!-- Нет подключения -->
      <Border Classes="M3Card"
              Background="#30FFB000"
              BorderBrush="#40FFB000"
              Padding="20"
              IsVisible="{Binding !IsConnected}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="24" Height="24" Foreground="#FFD54F" VerticalAlignment="Top" Margin="0,2,0,0"/>
          <TextBlock Text="{l:Tr Common_DeployFirst}"
                     TextWrapping="Wrap"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="#FFE082"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Статус сервиса -->
      <Border Classes="M3Card" Padding="20" IsVisible="{Binding IsConnected}">
        <StackPanel Spacing="16">
          <StackPanel Spacing="8">
            <TextBlock Text="{l:Tr Dash_XrayStatus}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <!-- Цветной индикатор -->
              <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                <Ellipse.Fill>
                  <SolidColorBrush Color="{Binding StatusColorHex}"/>
                </Ellipse.Fill>
              </Ellipse>
              <TextBlock Text="{Binding ServiceStatus}"
                          FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
            <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}">
              <Run Text="{l:Tr Common_Updated}"/><Run Text="{Binding LastUpdated}"/>
            </TextBlock>
          </StackPanel>

          <!-- Кнопки -->
          <WrapPanel Orientation="Horizontal">
            <Button Content="{l:Tr Common_Refresh}"
                    Classes="Tonal"
                    Command="{Binding RefreshStatusCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    MinHeight="48"
                    Margin="0,0,8,8"/>
            <Button Content="{l:Tr Dash_Restart}"
                    Command="{Binding RestartServiceCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    MinHeight="48"
                    Margin="0,0,0,8"/>
          </WrapPanel>

          <ProgressBar IsIndeterminate="True"
                       IsVisible="{Binding IsBusy}"
                       Foreground="{StaticResource PrimaryBrush}"
                       Height="4"
                       Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <!-- Проверка конфига -->
      <Border Classes="M3Card" Padding="20" IsVisible="{Binding IsConnected}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="{l:Tr Dash_XrayConfig}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
              <TextBlock Text="{l:Tr Dash_XrayConfigHint}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{l:Tr Dash_CheckConfig}"
                    Classes="Tonal"
                    Command="{Binding ValidateConfigCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Margin="8,0,0,0"
                    VerticalAlignment="Top"/>
          </Grid>

          <Border Background="{StaticResource M3SurfaceContainerHighBrush}"
                  CornerRadius="12"
                  Padding="12"
                  IsVisible="{Binding ConfigCheckText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding ConfigValidityText}"
                         Classes.Valid="{Binding IsConfigValid}"
                         FontWeight="Bold"
                         FontSize="13"
                         VerticalAlignment="Center">
                <TextBlock.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="#F2B8B5"/>
                  </Style>
                  <Style Selector="TextBlock.Valid">
                    <Setter Property="Foreground" Value="#81C784"/>
                  </Style>
                </TextBlock.Styles>
              </TextBlock>
              <TextBlock Text="{Binding ConfigCheckText}"
                         TextWrapping="Wrap"
                         FontFamily="Cascadia Code, Consolas, Monospace"
                         FontSize="12"
                         Foreground="#E2E2E6"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- Починка VPN-ссылок: 3 SNI-профиля                              -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <StackPanel IsVisible="{Binding IsConnected}" Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,4">
          <Border Background="{StaticResource PrimaryContainerBrush}"
                  Width="40" Height="40"
                  CornerRadius="12">
            <materialIcons:MaterialIcon Kind="LinkVariant" Width="22" Height="22" Foreground="{StaticResource PrimaryBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{l:Tr Dash_VpnProfiles}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="{l:Tr Dash_VpnProfilesHint}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
          </StackPanel>
        </StackPanel>

        <!-- Кнопка загрузки профилей -->
        <Button Content="{l:Tr Dash_LoadProfiles}"
                Classes="Tonal"
                Command="{Binding LoadSniProfilesCommand}"
                IsEnabled="{Binding !IsBusy}"
                IsVisible="{Binding !SniProfiles.Count}"
                MinHeight="48"/>

        <ItemsControl ItemsSource="{Binding SniProfiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SniProfileItem">
              <Border Classes="M3Card" Padding="16" Margin="0,4">
                <StackPanel Spacing="10">
                  <!-- Верхняя часть: Tag + Port + текущий SNI -->
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Иконка -->
                    <Border Grid.Column="0"
                            Background="{StaticResource PrimaryContainerBrush}"
                            Width="40" Height="40"
                            CornerRadius="20"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                      <materialIcons:MaterialIcon Kind="ServerNetwork" Width="20" Height="20"
                                                  Foreground="{StaticResource PrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Info -->
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Tag}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <Border Background="{StaticResource M3SurfaceContainerHighBrush}"
                                CornerRadius="8" Padding="8,3">
                          <TextBlock Text="{Binding Port, StringFormat='Port: {0}'}"
                                     FontSize="11" FontWeight="SemiBold"
                                     Foreground="{StaticResource MutedTextBrush}"/>
                        </Border>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Earth" Width="14" Height="14"
                                                    Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentSni}"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontFamily="Cascadia Code, Consolas, Monospace"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- Кнопка "Не работает?" -->
                    <Button Grid.Column="2"
                            Command="{Binding ToggleRepairPanelCommand}"
                            VerticalAlignment="Center"
                            MinHeight="40">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Wrench" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr Dash_NotWorking}" FontSize="12" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </Grid>

                  <!-- Раскрывающаяся панель ремонта -->
                  <Border IsVisible="{Binding IsExpanded}"
                          Background="{StaticResource M3SurfaceContainerHighBrush}"
                          CornerRadius="16"
                          Padding="16"
                          Margin="0,4,0,0">
                    <StackPanel Spacing="12">
                      <TextBlock Text="{l:Tr Dash_ReplaceSni}"
                                 FontSize="14" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}"/>
                      <TextBlock Text="{l:Tr Dash_ReplaceSniHint}"
                                 FontSize="12"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 TextWrapping="Wrap"/>

                      <!-- Поле ввода нового SNI -->
                      <TextBox Text="{Binding NewSni}"
                               PlaceholderText="{l:Tr Dash_SniExample}"
                               IsEnabled="{Binding !IsBusy}"/>

                      <!-- Кнопки -->
                      <WrapPanel Orientation="Horizontal">
                        <Button Classes="Primary"
                                Command="{Binding ApplyManualSniCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                MinHeight="44"
                                Margin="0,0,8,6">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Check" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Tr Common_Apply}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Button Classes="Tonal"
                                Command="{Binding AutoSelectSniCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                MinHeight="44"
                                Margin="0,0,0,6">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="AutoFix" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Tr Dash_AutoSelect}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                      </WrapPanel>

                      <!-- Индикатор загрузки -->
                      <ProgressBar IsIndeterminate="True"
                                   IsVisible="{Binding IsBusy}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Height="4"/>

                      <!-- Статус операции -->
                      <TextBlock Text="{Binding StatusMessage}"
                                 FontSize="12"
                                 Foreground="#81C784"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                      <!-- Перегенерированная VLESS-ссылка -->
                      <Border IsVisible="{Binding GeneratedLink, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Background="{StaticResource M3SurfaceContainerBrush}"
                              CornerRadius="12"
                              Padding="12"
                              Margin="0,4,0,0">
                        <StackPanel Spacing="8">
                          <TextBlock Text="{l:Tr Dash_NewVlessLink}"
                                     FontSize="12" FontWeight="SemiBold"
                                     Foreground="{StaticResource PrimaryBrush}"/>
                          <TextBlock Text="{Binding GeneratedLink}"
                                     FontSize="11"
                                     FontFamily="Cascadia Code, Consolas, Monospace"
                                     Foreground="#E2E2E6"
                                     TextWrapping="Wrap"
                                     MaxLines="3"/>

                          <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding CopyLinkCommand}"
                                    MinHeight="36"
                                    Margin="0,0,8,0">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CopyLabel}" FontSize="12" VerticalAlignment="Center"/>
                              </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleQrCommand}"
                                    MinHeight="36">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Qrcode" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="QR" FontSize="12" VerticalAlignment="Center"/>
                              </StackPanel>
                            </Button>
                          </WrapPanel>

                          <!-- QR-код -->
                          <Image Source="{Binding QrCodeImage}"
                                 Width="200" Height="200"
                                 IsVisible="{Binding QrCodeImage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 Margin="0,4,0,0"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Трафик -->
      <StackPanel IsVisible="{Binding IsConnected}" Spacing="10">
        <TextBlock Text="{l:Tr Dash_TrafficByInbound}"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"/>

        <TextBlock Text="{l:Tr Dash_NoData}"
                   Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                   IsVisible="{Binding TrafficStats.Count, Converter={x:Static ObjectConverters.IsNull}}"/>

        <!-- Визуальный график трафика (только если есть данные) -->
        <Border Classes="M3Card" Padding="20" IsVisible="{Binding HasTrafficData}" Margin="0,4">
          <StackPanel Spacing="16">
            <!-- Верхняя строка: Название и общая сумма -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{l:Tr Dash_TrafficDistribution}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{l:Tr Dash_Total}" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Text="{Binding TotalAllTrafficFormatted}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
              </StackPanel>
            </Grid>

            <!-- Полоса Stacked Bar Chart (заполняется из code-behind) -->
            <Border CornerRadius="8" ClipToBounds="True" Height="16" Background="#15FFFFFF">
              <Grid x:Name="ChartBarGrid"/>
            </Border>

            <!-- Легенда под графиком (заполняется из code-behind) -->
            <WrapPanel x:Name="ChartLegendPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding TrafficStats}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:InboundTrafficStat">
              <Border Classes="M3Card" Padding="16" Margin="0,4">
                <StackPanel Spacing="8">
                  <!-- Inbound Name & Total -->
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                      <Border Background="{StaticResource PrimaryContainerBrush}"
                              Width="36" Height="36"
                              CornerRadius="18"
                              VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="SwapVertical" Width="18" Height="18" Foreground="{StaticResource PrimaryBrush}"/>
                      </Border>
                      <TextBlock Text="{Binding Tag}"
                                 FontSize="15"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="{l:Tr Dash_Total}" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                      <TextBlock Text="{Binding TotalFormatted}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                  </Grid>

                  <!-- Traffic Stats & Balance Bar -->
                  <StackPanel Spacing="6" Margin="46,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="ArrowUp" Width="16" Height="16" Foreground="#81C784" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UplinkFormatted}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#81C784" VerticalAlignment="Center"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="ArrowDown" Width="16" Height="16" Foreground="#64B5F6" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DownlinkFormatted}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#64B5F6" VerticalAlignment="Center"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- Полоса соотношения Uplink/Downlink -->
                    <ProgressBar Value="{Binding UplinkPercent}" 
                                 Maximum="100" 
                                 Background="#64B5F6" 
                                 Foreground="#81C784"
                                 Height="6" 
                                 CornerRadius="3"
                                 MinWidth="200" 
                                 MaxWidth="300"
                                 HorizontalAlignment="Left" 
                                 Margin="0,4,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
