<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <!--
      Microsoft.AspNetCore.DataProtection: используется для безопасного
      хранения паролей SSH в профилях VdsProfile. Кроссплатформенный:
        - Windows: ключи в %LOCALAPPDATA%\ASP.NET\DataProtection-Keys, шифруются DPAPI
        - Linux:   ~/.aspnet/DataProtection-Keys, защищены filesystem permissions (0600)
        - macOS:   ~/Library/Application Support/ASP.NET/DataProtection-Keys
      DataProtectionProvider.Create() находится в пакете
      Microsoft.AspNetCore.DataProtection.Extensions, без него тип
      DataProtectionProvider недоступен.
    -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Скрипты встроены прямо в exe — никаких файлов рядом не нужно -->
    <EmbeddedResource Include="VDS_setup\MainInstall.sh" />
    <EmbeddedResource Include="VDS_setup\Deploy.sh" />
    <EmbeddedResource Include="VDS_setup\config.json" />
  </ItemGroup>

</Project>
