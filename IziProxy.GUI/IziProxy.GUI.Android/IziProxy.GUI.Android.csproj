<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.iziproxy.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Release signing -->
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)../../iziproxy-release.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>iziproxy</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>iziproxy123</AndroidSigningKeyPass>
    <AndroidSigningStorePass>iziproxy123</AndroidSigningStorePass>
    <!-- Дополнительные параметры сборщика Java для предотвращения сбоев java.exe (код 2) -->
    <AndroidMaximumJavaCompilerHeapSize>2G</AndroidMaximumJavaCompilerHeapSize>
    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
    <!-- Отключение R8/Proguard shrinking для предотвращения крашей рефлексии (SSH-Net, BouncyCastle) -->
    <AndroidLinkTool></AndroidLinkTool>
    <AndroidEnableProguard>false</AndroidEnableProguard>
    <!-- Только arm64 — современные устройства, меньше памяти при сборке -->
    <AndroidSupportedAbis>arm64-v8a</AndroidSupportedAbis>
    <!-- Увеличиваем heap для D8/R8 дексера -->
    <JavaMaximumHeapSize>2G</JavaMaximumHeapSize>
    <!-- AOT: значительно ускоряет холодный старт на Android -->
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <!-- Trimming: убирает неиспользуемые сборки, уменьшает размер APK -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Отключаем тяжёлые ICU-данные глобализации (не нужны для ru/en) -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IziProxy.GUI\IziProxy.GUI.csproj" />
  </ItemGroup>
</Project>
